{
  "name": "@carldog/mnemosyne-mcp",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "description": "MCP server for long-form storytelling on top of OpenChronicle memory",
  "type": "module",
  "bin": {
    "mnemosyne-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:webui",
    "build:server": "tsc",
    "build:webui": "cd webui && npm ci && npm run build && cd .. && node scripts/copy-webui-dist.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:content": "node scripts/audit-tracked-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
