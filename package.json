{
  "name": "@carldog/mnemosyne-mcp",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "description": "MCP server for long-form storytelling on top of OpenChronicle memory",
  "type": "module",
  "bin": {
    "mnemosyne-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:webui",
    "build:server": "tsc",
    "build:webui": "cd webui && npm ci && npm run build && cd .. && node scripts/copy-webui-dist.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
