// Typecheck-only config: same compiler options as the build, widened to
// cover everything the build deliberately leaves out.
//
// tsconfig.json is the *build* config — `include: src/**/*` with a matching
// rootDir, so `dist/` mirrors `src/`. Adding tests there would emit them
// into dist and break rootDir. But vitest only transpiles, it never
// typechecks, so without this config a type error in tests/ surfaced at
// runtime (or not at all) rather than from `npm run typecheck`.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  // Override, not extend: tsconfig.json's own exclude has "**/*.test.ts"
  // (kept out of the dist build), and tsconfig inheritance means an
  // unoverridden exclude still applies even though every test file is
  // explicitly listed in this config's own `include` below -- exclude wins
  // over include. Left inherited, this defeated the whole point of this
  // file: every *.test.ts was silently skipped, so a type error in a test
  // surfaced at runtime (or not at all) instead of from `npm run typecheck`.
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts"]
}
