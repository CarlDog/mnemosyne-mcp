# Dependencies
node_modules/

# Build output
dist/

# Logs
*.log
npm-debug.log*

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.local
.env.*.local
*.pfx
*.p12
*.pem
*.key

# Python virtual envs (defensive)
.venv/
venv/

# Test output
coverage/

# Project-scoped Claude Code MCP config — bakes in absolute paths +
# personal infrastructure URLs (NAS endpoint, etc.). Each developer
# runs Claude Code from their own clone with their own OC instance,
# so this is intentionally per-machine.
.mcp.json

# Per-developer tool / session state (Claude Code agent state,
# Serena MCP project memories). Tool-specific, not portable.
.claude/
.serena/

# Scratch directory for ad-hoc test content (e.g. dump-validation.mjs
# input files). Transient by convention.
tmp/

# Runtime data (current-story pointer + story exports). Repo-local so a
# Docker deployment can bind-mount it as persistent storage; override
# with MNEMO_DATA_DIR.
data/
