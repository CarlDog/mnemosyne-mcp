# OpenChronicle MCP endpoint (required).
# The home-LAN OC v3 deployment lives at http://your-nas:18000/mcp.
OC_URL=http://your-nas:18000/mcp

# Optional: which backend generates story beats. Default: ollama.
# One of: ollama, kindroid, botify, anthropic, openai, gemini, atlascloud.
# The companion-chat providers (kindroid, botify) generate via a stateful
# character chat (see their sections below); the cloud providers
# (anthropic, openai, gemini, atlascloud) are direct LLM APIs honoring
# the system-prompt + per-call model surface, with temperature/token
# caps passed through only when explicitly set (each API's own defaults
# apply otherwise -- several current-gen models reject the fields
# outright, e.g. Claude Opus 4.7+ rejects temperature). The validator
# pass ALWAYS runs on Ollama regardless of this setting -- so every
# non-ollama choice requires OLLAMA_VALIDATOR_MODEL.
# GENERATOR_PROVIDER=ollama

# Ollama generator model (required when GENERATOR_PROVIDER=ollama, the
# default). The host LLM uses this for the storytelling generation pass.
# Recommended starting points:
#   - HammerAI/mythomax-l2:latest  (13B, roleplay-tuned, lighter)
#   - nous-hermes2-mixtral:latest  (47B, heavier but stronger)
# Anything in `ollama list` works; the model just needs to support
# /api/chat with a system + user message pair.
OLLAMA_GENERATOR_MODEL=HammerAI/mythomax-l2:latest

# Model for the validation pass (when mnemo_continue is called with
# validate=true). Optional and defaults to OLLAMA_GENERATOR_MODEL when
# GENERATOR_PROVIDER=ollama -- but REQUIRED for EVERY other generator
# (kindroid, botify, anthropic, openai, gemini, atlascloud), since there
# is then no Ollama generator model to fall back to (the validator always
# runs on Ollama). A smaller / faster model is fine here -- the validator
# just needs to return structured JSON, not creative prose.
# OLLAMA_VALIDATOR_MODEL=mistral-nemo:12b

# Optional: Ollama base URL. Default: http://localhost:11434.
# OLLAMA_URL=http://localhost:11434

# ---- Kindroid generator (only used when GENERATOR_PROVIDER=kindroid) ----

# kindroid-mcp's Streamable HTTP endpoint (required when
# GENERATOR_PROVIDER=kindroid). kindroid-mcp is a sibling MCP server, not
# embedded here -- it must be running and reachable.
# KINDROID_MCP_URL=http://your-nas:3008/mcp

# Bearer token for kindroid-mcp's HTTP transport, if it requires one
# (MCP_AUTH_TOKEN on that server). Omit if kindroid-mcp has no auth token
# configured.
# KINDROID_MCP_AUTH_TOKEN=

# The server-wide default storytelling target: a single Kindroid AI, OR a
# Kindroid group chat -- set exactly one of the two vars below (required
# when GENERATOR_PROVIDER=kindroid; setting both is a startup error). Either
# accepts a raw Kindroid ai_id/group_id, or a name registered in
# kindroid-mcp's local registry (resolved server-side). The target's own
# persona/memory on Kindroid's servers carries story continuity --
# mnemosyne does NOT re-inject its OC-assembled rules/style/characters/etc.
# context into every message when using this provider. For a group, each
# beat drives the group's turn loop (a few AI replies exchanged in
# sequence) rather than a single reply.
#
# This is only the fallback. Precedence per mnemo_continue call: an
# explicit kindroid_kin/kindroid_group_id argument on that call wins, then
# the active story's own bound target (set via mnemo_story_use's
# kindroid_kin/kindroid_group_id params -- lets each story default to a
# different target without repeating an override on every call), then
# these env vars.
# KINDROID_STORYTELLING_KIN=
# KINDROID_STORYTELLING_GROUP=

# ---- Botify generator (only used when GENERATOR_PROVIDER=botify) ----

# botify-mcp's Streamable HTTP endpoint (required when
# GENERATOR_PROVIDER=botify). botify-mcp is a sibling MCP server, not
# embedded here -- it must be running and reachable, and must have its
# own BOTIFY_APP_TOKEN configured server-side (without it, bot replies
# are never generated inline and every mnemo_continue fails).
# BOTIFY_MCP_URL=http://your-nas:3005/mcp

# Bearer token for botify-mcp's HTTP transport, if it requires one
# (MCP_AUTH_TOKEN on that server). Omit if none is configured.
# BOTIFY_MCP_AUTH_TOKEN=

# The dedicated storytelling chat: a Botify chat UUID (an existing chat
# thread with the storytelling bot -- find it via botify-mcp's
# list_chats). Required when GENERATOR_PROVIDER=botify. The bot's own
# persona + the chat's server-side history carry story continuity;
# mnemosyne folds keyphrase-matched story entities into each message the
# same way the Kindroid provider does.
# BOTIFY_STORYTELLING_CHAT=

# ---- Cloud LLM generators (anthropic / openai / gemini / atlascloud) ----
# Each is only used when GENERATOR_PROVIDER matches. All require an API
# key and an EXPLICIT model id (no baked-in defaults -- model names age
# fast), plus OLLAMA_VALIDATOR_MODEL (the validator stays on Ollama).

# Anthropic Messages API.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI chat completions -- or ANY OpenAI-compatible host via
# OPENAI_BASE_URL (Groq, Together, a local vLLM...). Default base:
# https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=

# Google Gemini (generateContent API).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Atlas Cloud's OpenAI-compatible LLM API. Default base:
# https://api.atlascloud.ai/v1 (deliberately direct -- NOT via the
# deployed atlascloud-mcp, whose atlas_chat tool returns markdown a
# machine caller can't safely parse a completion back out of). Model ids
# per Atlas's catalog, e.g. deepseek-ai/deepseek-v3.2.
# ATLASCLOUD_API_KEY=
# ATLASCLOUD_MODEL=
# ATLASCLOUD_BASE_URL=

# Optional: override the local config directory.
# Defaults: %APPDATA%\mnemosyne-mcp on Windows,
#           $XDG_CONFIG_HOME/mnemosyne-mcp or ~/.config/mnemosyne-mcp on POSIX.
# MNEMOSYNE_CONFIG_DIR=

# Optional: log level (trace|debug|info|warn|error). Default: info.
# LOG_LEVEL=info
