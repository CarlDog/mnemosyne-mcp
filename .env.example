# ===========================================================================
# mnemosyne-mcp -- environment reference
# ===========================================================================
# How env actually reaches the server (nothing auto-loads a .env file):
#   - MCP hosts (Claude Code / Claude Desktop): the "env" block of the
#     server entry in .mcp.json / claude config.
#   - Manual runs: `node --env-file=.env dist/index.js` (Node 22+), or
#     export the vars in your shell before `npm run dev`.
#   - The scripts/ diagnostics read the shell environment.
# Copy this file to .env (gitignored) and fill in placeholders.
#
# Quick reference -- what is required when:
#   Always:                        OC_URL
#   GENERATOR_PROVIDER=ollama:     OLLAMA_GENERATOR_MODEL   (the default)
#   any OTHER generator:           OLLAMA_VALIDATOR_MODEL   (validator always
#                                  runs on Ollama) + that provider's own
#                                  section below
#
# ---------------------------------------------------------------------------
# 1. Core (required)
# ---------------------------------------------------------------------------

# OpenChronicle MCP endpoint. Every story's state lives there; the server
# exits at startup without it. The home-LAN OC v3 deployment lives at
# http://your-nas:18000/mcp.
OC_URL=http://your-nas:18000/mcp

# ---------------------------------------------------------------------------
# 2. Generator selection
# ---------------------------------------------------------------------------

# Which backend generates story beats. Default: ollama.
# One of: ollama, kindroid, botify, anthropic, openai, gemini, atlascloud.
#   - Companion-chat providers (kindroid, botify): a stateful character
#     chat carries continuity; mnemosyne folds keyphrase-matched story
#     entities into each message. No system prompt / temperature / model
#     knobs.
#   - Cloud providers (anthropic, openai, gemini, atlascloud): direct LLM
#     APIs honoring the system-prompt + per-call model surface, with
#     temperature/token caps passed through only when explicitly set
#     (each API's own defaults apply otherwise -- several current-gen
#     models reject the fields outright, e.g. Claude Opus 4.7+ rejects
#     temperature).
# The validator pass ALWAYS runs on Ollama regardless of this setting.
# GENERATOR_PROVIDER=ollama

# Operator display name, used only by the companion-chat providers
# (kindroid, botify) to mark every outgoing message as an automated note
# rather than the operator typing -- e.g. "[Mnemosyne -- automated scene
# direction, not Carl typing]". Square brackets + descriptive (not
# imperative) framing are deliberate: researched against Kindroid/AI
# Dungeon documentation and community convention (2026-08-23), not
# guessed. Mirrors watch-companion's own "[Watch Companion -- automated ...
# note, not USER_NAME typing]" header, already live there. No effect on
# the five direct-LLM providers (stateless per-call completions have no
# "who's really typing" concept to protect). Default: Carl.
# MNEMO_USER_NAME=Carl

# Scene-context strategy for recent-scenes selection in mnemo_continue:
# - recency-first (default): strict scene recency ordering.
# - query-ranked: query-relevance ordering from OC's memory_search.
# Either way the validation filter applies on top: validation:clean
# scenes lead, untagged scenes follow (each bucket keeping the
# strategy's own order), validation:errors scenes are always excluded.
# MNEMO_SCENE_CONTEXT_STRATEGY=recency-first
# Optional fallback if the primary scene-context strategy produces no eligible
# scenes after hard filtering. Useful when one strategy can return only
# validation:errors for a story but another strategy might still produce
# usable context. Applies only when a call does NOT set its own
# scene_context_strategy -- a per-call primary override runs pure (no
# fallback) unless that call also passes scene_context_fallback_strategy.
# MNEMO_SCENE_CONTEXT_FALLBACK_STRATEGY=recency-first

# ---------------------------------------------------------------------------
# 3. Ollama -- the default generator, and ALWAYS the validator
# ---------------------------------------------------------------------------

# Generator model (required when GENERATOR_PROVIDER=ollama, the default).
# Recommended starting points:
#   - HammerAI/mythomax-l2:latest  (13B, roleplay-tuned, lighter)
#   - nous-hermes2-mixtral:latest  (47B, heavier but stronger)
# Anything in `ollama list` works; the model just needs to support
# /api/chat with a system + user message pair.
OLLAMA_GENERATOR_MODEL=HammerAI/mythomax-l2:latest

# Model for the validation pass (mnemo_continue's validate=true /
# mnemo_validate). Optional when GENERATOR_PROVIDER=ollama (falls back to
# OLLAMA_GENERATOR_MODEL) -- REQUIRED for every other generator, since
# there is then no Ollama generator model to fall back to. A smaller /
# faster model is fine: the validator returns structured JSON, not prose.
# The validator is LOCAL-ONLY by contract: `:cloud` tags and remote-host
# aliases are refused (the request carries the story's full canon, and the
# pass is documented as free). For belt-and-braces, set OLLAMA_NO_CLOUD=1 in
# the Ollama daemon's own environment so the daemon itself refuses cloud
# routing regardless of client behavior.
# OLLAMA_VALIDATOR_MODEL=mistral-nemo:12b

# Ollama base URL. Default: http://localhost:11434.
# OLLAMA_URL=http://localhost:11434

# Cap on the per-request context window. Every request auto-sizes
# num_ctx to its actual prompt (a fully-imported story's assembled
# prompt can run ~16k tokens — far past Ollama's own ~4k default, which
# silently truncates and produces word salad), bounded by this cap.
# Default: 32768. Two reasons to change it: lower it for models whose
# TRAINED context is small (e.g. llama2-era 4k models like mythomax —
# pushing num_ctx past the trained window degrades output), or raise it
# for very large stories on models that support it (mistral-nemo and
# llama3.1 are 128k-trained). VRAM/RAM cost grows with the window.
# OLLAMA_NUM_CTX=32768

# Keep models loaded between calls to reduce first-call latency after a
# period of inactivity. This value is passed straight through to Ollama's
# /api/chat keep_alive field.
# Default: 30m. Accepts a duration string (30m, 90s, 1h30m) or a whole
# number of seconds. Set -1 to keep the model pinned indefinitely, 0 to
# unload immediately after each request; the server sends wholly numeric
# values as JSON numbers, because Ollama rejects the STRING "-1" with an
# HTTP 400 while accepting the number -1.
# OLLAMA_KEEP_ALIVE=30m

# Per-request Ollama /api/chat timeout in ms. Default 300000 (5 minutes).
# Raise for CPU/NAS deployments where a big-story generation legitimately
# runs long; a timeout is never retried automatically (the daemon may
# still be working on the request -- a blind retry doubles the queue).
# OLLAMA_TIMEOUT_MS=300000

# Startup model warmup (preload the Ollama generator/validator so the
# first real call skips the cold start). Runs automatically in HTTP mode
# (MCP_PORT set) -- one long-lived server, preloading pays off. stdio
# servers are spawned per host session and skip warmup by default, so a
# session that only browses entities doesn't pin models in RAM; set
# MNEMO_WARMUP=true to opt a stdio deployment in.
# MNEMO_WARMUP=true

# ---------------------------------------------------------------------------
# 4. Kindroid (GENERATOR_PROVIDER=kindroid)
# ---------------------------------------------------------------------------

# kindroid-mcp's Streamable HTTP endpoint (required). A sibling MCP
# server, not embedded here -- it must be running and reachable.
# KINDROID_MCP_URL=http://your-nas:3008/mcp

# Bearer token for kindroid-mcp's HTTP transport, if it requires one
# (MCP_AUTH_TOKEN on that server). Omit if none is configured.
# KINDROID_MCP_AUTH_TOKEN=

# The server-wide default storytelling target: a single Kindroid AI, OR a
# Kindroid group chat -- set exactly one (setting both is a startup
# error). Either accepts a raw ai_id/group_id or a kindroid-mcp
# registered name. The kin's own persona/memory carries continuity.
# Precedence per mnemo_continue call: explicit kindroid_kin /
# kindroid_group_id argument wins, then the active story's bound target
# (mnemo_story_use), then these.
# KINDROID_STORYTELLING_KIN=
# KINDROID_STORYTELLING_GROUP=

# How many AI turns a GROUP target generates per beat (1-8, default 4 --
# kindroid_advance_group's own bound and default). A beat against a group
# is a few characters exchanging lines, so this is the group's beat
# LENGTH, not a token cap. No effect on a single-AI target, which always
# produces exactly one reply. Override per call with mnemo_continue's
# group_max_turns.
# KINDROID_GROUP_MAX_TURNS=4

# Per-request timeout for kindroid-mcp calls, in ms (default 240000: above
# kindroid-mcp's own worst case for one send, its 60000 request timeout plus
# its 120000 same-key re-send budget, so a send resolves in one call).
# Well above the MCP SDK's own 60s default on purpose: a group beat chains
# KINDROID_GROUP_MAX_TURNS SEQUENTIAL model generations before returning
# (~13s each, measured), so 8 turns needs ~105s of generation alone. Erring
# long is the safe direction -- a mid-flight timeout does NOT mean "nothing
# happened" (the message may already be posted and replies generated), so a
# too-short timeout manufactures an ambiguous, retry-hazardous failure.
# KINDROID_MCP_TIMEOUT_MS=240000

# ---------------------------------------------------------------------------
# 5. Botify (GENERATOR_PROVIDER=botify)
# ---------------------------------------------------------------------------

# botify-mcp's Streamable HTTP endpoint (required). A sibling MCP server
# -- must be running, reachable, and have its own BOTIFY_APP_TOKEN
# configured server-side (without it, bot replies are never generated
# inline and every mnemo_continue fails).
# BOTIFY_MCP_URL=http://your-nas:3005/mcp

# Bearer token for botify-mcp's HTTP transport, if it requires one.
# BOTIFY_MCP_AUTH_TOKEN=

# The dedicated storytelling chat: a Botify chat UUID (an existing chat
# thread with the storytelling bot -- find it via botify-mcp's
# list_chats). Required.
# BOTIFY_STORYTELLING_CHAT=

# Per-request timeout for botify-mcp calls, in ms. Default 180000 (3min),
# matching KINDROID_MCP_TIMEOUT_MS's reasoning: a mid-flight timeout does
# not mean nothing happened -- the direction may already be posted -- so
# erring long avoids manufacturing ambiguous, retry-hazardous failures.
# BOTIFY_MCP_TIMEOUT_MS=180000

# ---------------------------------------------------------------------------
# 6. Cloud LLM providers (anthropic / openai / gemini / atlascloud)
# ---------------------------------------------------------------------------
# Each is used only when GENERATOR_PROVIDER matches. All require an API
# key and an EXPLICIT model id -- no baked-in model defaults, model names
# age fast. (And OLLAMA_VALIDATOR_MODEL above, like every non-ollama
# generator.)

# Anthropic Messages API.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI chat completions -- or ANY OpenAI-compatible host via
# OPENAI_BASE_URL (Groq, Together, a local vLLM...). Default base:
# https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=

# Google Gemini (generateContent API).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Atlas Cloud's OpenAI-compatible LLM API. Default base:
# https://api.atlascloud.ai/v1 (deliberately direct -- NOT via the
# deployed atlascloud-mcp, whose atlas_chat tool returns markdown a
# machine caller can't safely parse). Model ids per Atlas's catalog,
# e.g. deepseek-ai/deepseek-v3.2.
# ATLASCLOUD_API_KEY=
# ATLASCLOUD_MODEL=
# ATLASCLOUD_BASE_URL=

# ---------------------------------------------------------------------------
# 7. Local overrides (optional)
# ---------------------------------------------------------------------------

# Data directory: config.json (current-story pointer) plus one
# stories/<slug>/ subtree per storyline (exports/ backups, references/
# operator-curated assets). Default: <repo>/data (gitignored).
# Repo-local so a Docker deployment can bind-mount the same path as
# persistent storage. Set explicitly for an npm-installed
# (non-checkout) copy — the default would land inside node_modules and
# be wiped by the next reinstall.
# MNEMO_DATA_DIR=

# LEGACY: pre-data-dir config location override. Consulted only when the
# data dir has no config.json yet — a config.json found at the legacy
# location (default: %APPDATA%\mnemosyne-mcp on Windows,
# $XDG_CONFIG_HOME/mnemosyne-mcp or ~/.config/mnemosyne-mcp on POSIX) is
# copied into the data dir on first read.
# MNEMOSYNE_CONFIG_DIR=

# Vague-direction query enrichment (RETRIEVAL_CONTROLS_DESIGN slice 3,
# ratified to ship OFF): when true, a vague direction ("continue", or a
# <20-char direction naming no known entity) has the newest eligible
# scene's name + a <=120-char tail appended to the four REFERENCE queries
# (characters/locations/lore/worldbuilding) -- rules/style/scene selection
# keep the raw direction. The default flips only when the settled-fixtures
# benchmark records a recall win without an unwanted-persistence
# regression (see the design doc).
# MNEMO_QUERY_ENRICHMENT=false

# Context-admission enforcement (CONTEXT_PLAN_DESIGN, ratified): "warn"
# (default) logs when protected rules/style + the direction exceed the
# model-aware effective window but still dispatches; "enforce" turns that
# into a pre-dispatch error. Ratified to stay "warn" until estimator
# calibration data accumulates (the chars/3.5 estimate deliberately
# overshoots).
# MNEMO_CONTEXT_ADMISSION=warn

# HTTP-mode shutdown drain: how long a SIGTERM/SIGINT waits for in-flight
# requests to finish before closing MCP sessions and the OC connection and
# exiting. Default 30000 (30s).
# MNEMO_SHUTDOWN_GRACE_MS=30000

# Log level (trace|debug|info|warn|error). Default: info. All logging
# goes to stderr -- stdout is the MCP wire protocol.
# LOG_LEVEL=info

# Narrative prose (entity content, scene directions) is NEVER logged by
# default -- tool logs record lengths and counts, not story text. Set this
# to true (with LOG_LEVEL=debug) as a short-lived opt-in when you need the
# full tool arguments for content debugging; turn it back off afterward.
# MNEMO_LOG_CONTENT=false

# ---------------------------------------------------------------------------
# 8. HTTP transport (optional -- Streamable HTTP for a browser client)
# ---------------------------------------------------------------------------
# Unset (default) runs stdio only, unchanged from every existing
# stdio/Claude-Desktop deployment. Set MCP_PORT to switch this server
# itself to a Streamable HTTP endpoint -- the transport used by the current
# Web UI and other remote-capable MCP clients. Do NOT confuse MCP_AUTH_TOKEN
# below with
# KINDROID_MCP_AUTH_TOKEN / BOTIFY_MCP_AUTH_TOKEN above: those are
# CLIENT-side bearer tokens this server sends to its own sibling MCP
# servers; MCP_AUTH_TOKEN is the SERVER-side token THIS server requires
# from ITS callers.
# MCP_PORT=

# HTTP bind host. Default: 127.0.0.1. A container must bind 0.0.0.0 to be
# reachable at all. MCP_ALLOWED_HOSTS provides DNS-rebinding defense;
# MCP_AUTH_TOKEN authenticates callers. Neither control makes caller-selected
# server filesystem paths safe for an untrusted client: until the transport
# path policy in docs/NEMOCLAW_ADOPTION_ASSESSMENT.md is implemented, expose
# mnemo_import_story(file_path) / mnemo_export_story(out_path) only to trusted
# operators.
# MCP_BIND_HOST=127.0.0.1

# Comma-separated bare-hostname Host/Origin allowlist (DNS-rebinding
# protection; port-independent, bracketed IPv6 like [::1] supported). Unset
# falls back to localhost,127.0.0.1,[::1],host.docker.internal (startup
# warning) -- not open. A value parsing to zero usable entries, or
# containing a host:port entry, throws at startup.
# MCP_ALLOWED_HOSTS=

# Bearer token this server's own HTTP endpoint requires from callers.
# Unset disables auth (startup warning) -- set before exposing beyond
# localhost.
# MCP_AUTH_TOKEN=

# Idle-session eviction cutoff, ms. Default: 1800000 (30 minutes).
# MCP_SESSION_IDLE_MS=1800000
