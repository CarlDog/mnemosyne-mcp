# OpenChronicle MCP endpoint (required).
# The home-LAN OC v3 deployment lives at http://carldog-nas:18000/mcp.
OC_URL=http://carldog-nas:18000/mcp

# Optional: override the local config directory.
# Defaults: %APPDATA%\mnemosyne-mcp on Windows,
#           $XDG_CONFIG_HOME/mnemosyne-mcp or ~/.config/mnemosyne-mcp on POSIX.
# MNEMOSYNE_CONFIG_DIR=

# Optional: log level (trace|debug|info|warn|error). Default: info.
# LOG_LEVEL=info
